@model IEnumerable<Machine>

@{
    ViewData["Title"] = "Makineler";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Makine Yönetimi</h1>
        <p class="text-muted mb-0">Fabrikadaki makineleri görüntüleyin ve yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Yeni Makine Ekle</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Code)</th>
                        <th>@Html.DisplayNameFor(model => model.Name)</th>
                        <th>@Html.DisplayNameFor(model => model.MachineCategory)</th>
                        <th>@Html.DisplayNameFor(model => model.Status)</th>
                        <th>@Html.DisplayNameFor(model => model.InstallationDate)</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Henüz makine kaydı bulunmuyor.</td>
                    </tr>
                }
                else
                {
                    @foreach (var machine in Model)
                    {
                        var badgeClass = machine.Status switch
                        {
                            MachineStatus.Active => "text-bg-success",
                            MachineStatus.Maintenance => "text-bg-warning",
                            _ => "text-bg-secondary"
                        };
                        <tr>
                            <td class="fw-semibold">@machine.Code</td>
                            <td>@machine.Name</td>
                            <td>@machine.MachineCategory</td>
                            <td><span class="badge @badgeClass">@machine.Status</span></td>
                            <td>@machine.InstallationDate.ToString("dd.MM.yyyy")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@machine.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                <a asp-action="Edit" asp-route-id="@machine.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@machine.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
