@model Machine

@{
    ViewData["Title"] = "Makine Detayı";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Code - @Model.Name</h1>
        <p class="text-muted mb-0">Makine detayları ve operasyonel bilgiler</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Maintenances" asp-action="Create" asp-route-machineId="@Model.Id" class="btn btn-outline-success">
            + Bakım Kaydı Ekle
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Düzenle</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">Makine Kimlik ve Teknik Bilgileri</h5>
    </div>
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.MachineCategory)</dt>
            <dd class="col-sm-8">@Model.MachineCategory</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Manufacturer)</dt>
            <dd class="col-sm-8">@(Model.Manufacturer ?? "-")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Model)</dt>
            <dd class="col-sm-8">@(Model.Model ?? "-")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-8">
                @{
                    var statusBadge = Model.Status switch
                    {
                        MachineStatus.Active => "text-bg-success",
                        MachineStatus.Maintenance => "text-bg-warning",
                        _ => "text-bg-secondary"
                    };
                }
                <span class="badge @statusBadge">@Model.Status</span>
            </dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.InstallationDate)</dt>
            <dd class="col-sm-8">@Model.InstallationDate.ToString("dd.MM.yyyy")</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="card-title mb-0">Bakım Kayıtları (@(Model.Maintenances?.Count ?? 0))</h5>
        <a asp-controller="Maintenances" asp-action="Create" asp-route-machineId="@Model.Id" class="btn btn-sm btn-outline-primary">
            Yeni Bakım Planla
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Başlık</th>
                        <th>Tür</th>
                        <th>Öncelik</th>
                        <th>Durum</th>
                        <th>Planlanan Tarih</th>
                        <th>Maliyet</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Maintenances is null || !Model.Maintenances.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Bu makineye ait henüz bir bakım kaydı bulunmuyor.</td>
                    </tr>
                }
                else
                {
                    @foreach (var maintenance in Model.Maintenances)
                    {
                        var mStatusBadge = maintenance.Status switch
                        {
                            MaintenanceStatus.Completed => "text-bg-success",
                            MaintenanceStatus.InProgress => "text-bg-primary",
                            MaintenanceStatus.Scheduled => "text-bg-warning",
                            _ => "text-bg-secondary"
                        };

                        var mPriorityBadge = maintenance.Priority switch
                        {
                            MaintenancePriority.Critical => "bg-danger text-white",
                            MaintenancePriority.High => "bg-warning text-dark",
                            MaintenancePriority.Medium => "bg-info text-dark",
                            _ => "bg-light text-dark border"
                        };

                        <tr>
                            <td class="fw-semibold">@maintenance.Title</td>
                            <td><span class="small">@maintenance.Type</span></td>
                            <td><span class="badge @mPriorityBadge">@maintenance.Priority</span></td>
                            <td><span class="badge @mStatusBadge">@maintenance.Status</span></td>
                            <td>@maintenance.ScheduledDate.ToString("dd.MM.yyyy")</td>
                            <td>@(maintenance.Cost.HasValue ? maintenance.Cost.Value.ToString("N2") + " ₺" : "-")</td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Maintenances" asp-action="Details" asp-route-id="@maintenance.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                                <a asp-controller="Maintenances" asp-action="Edit" asp-route-id="@maintenance.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
