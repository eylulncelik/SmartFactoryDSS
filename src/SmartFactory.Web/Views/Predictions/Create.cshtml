@model PredictionHistory

@{
    ViewData["Title"] = "AI Arıza Riski Tahmini";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">AI Arıza Riski Tahmin Simülasyonu</h1>
                <p class="text-muted mb-0">Makine telemetri sensör değerlerini girerek 24 saat içindeki arıza olasılığını tahmin edin.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Geçmişe Dön</a>
        </div>

        @if (ViewBag.IsAiServiceOnline is false)
        {
            <div class="alert alert-warning mb-4" role="alert">
                <strong>Dikkat:</strong> FastAPI AI servisi (`http://127.0.0.1:8000`) şu an yanıt vermiyor. Tahmin isteği gönderildiğinde servisin açık olması gerekir.
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light py-3">
                <span class="fw-semibold">⚡ Hızlı Test Senaryoları:</span>
                <button type="button" class="btn btn-sm btn-outline-success ms-2" onclick="applyPreset(22, 34, 1500, 35, 15)">
                    Normal Çalışma
                </button>
                <button type="button" class="btn btn-sm btn-outline-warning ms-1" onclick="applyPreset(27, 44, 2100, 58, 75)">
                    Yüksek Isı / Yük
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger ms-1" onclick="applyPreset(31, 51, 2800, 82, 175)">
                    Kritik Aşınma & Risk
                </button>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="MachineId" class="form-label fw-bold"></label>
                            <select asp-for="MachineId" asp-items="ViewBag.MachineList" class="form-select">
                                <option value="">-- Makine Seçiniz --</option>
                            </select>
                            <span asp-validation-for="MachineId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AirTemperature_C" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="AirTemperature_C" id="airTemp" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">°C</span>
                            </div>
                            <span asp-validation-for="AirTemperature_C" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProcessTemperature_C" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ProcessTemperature_C" id="processTemp" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">°C</span>
                            </div>
                            <span asp-validation-for="ProcessTemperature_C" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RotationalSpeed_RPM" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="RotationalSpeed_RPM" id="rotSpeed" class="form-control" type="number" step="1" />
                                <span class="input-group-text">RPM</span>
                            </div>
                            <span asp-validation-for="RotationalSpeed_RPM" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Torque_Nm" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Torque_Nm" id="torque" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">Nm</span>
                            </div>
                            <span asp-validation-for="Torque_Nm" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ToolWear_Min" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ToolWear_Min" id="toolWear" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">Dk</span>
                            </div>
                            <span asp-validation-for="ToolWear_Min" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-2 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            AI ile Riski Hesapla
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function applyPreset(air, process, rpm, torque, wear) {
            document.getElementById('airTemp').value = air;
            document.getElementById('processTemp').value = process;
            document.getElementById('rotSpeed').value = rpm;
            document.getElementById('torque').value = torque;
            document.getElementById('toolWear').value = wear;
        }
    </script>
}
