@model Maintenance

@{
    ViewData["Title"] = "Bakım Kaydı Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Bakım Kaydı Düzenle</h1>
                <p class="text-muted mb-0">#@Model.Id numaralı bakım kaydı bilgilerini güncelleyin.</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Detaya Dön</a>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />
                    <partial name="_MaintenanceForm" model="Model" />
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
