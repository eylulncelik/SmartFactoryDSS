@model Maintenance

@{
    ViewData["Title"] = "Bakım Kaydı Sil";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">Bakım Kaydını Sil</h1>
                <p class="text-muted">Bu işlem geri alınamaz. <strong>#@Model.Id - @Model.Title</strong> bakım kaydını silmek istediğinizden emin misiniz?</p>
                <dl class="row">
                    <dt class="col-sm-5">İlgili Makine</dt>
                    <dd class="col-sm-7">@(Model.Machine is not null ? $"{Model.Machine.Code} - {Model.Machine.Name}" : "-")</dd>
                    <dt class="col-sm-5">Bakım Türü</dt>
                    <dd class="col-sm-7">@Model.Type</dd>
                    <dt class="col-sm-5">Planlanan Tarih</dt>
                    <dd class="col-sm-7">@Model.ScheduledDate.ToString("dd.MM.yyyy")</dd>
                    <dt class="col-sm-5">Durum</dt>
                    <dd class="col-sm-7">@Model.Status</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input asp-for="Id" type="hidden" />
                    <button type="submit" class="btn btn-danger">Bakım Kaydını Sil</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>
