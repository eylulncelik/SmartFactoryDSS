@model Maintenance

@{
    ViewData["Title"] = "Yeni Bakım Kaydı";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Yeni Bakım Kaydı Ekle</h1>
                <p class="text-muted mb-0">Makineye ait planlı, periyodik veya arıza bakım detaylarını girin.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
        </div>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <partial name="_MaintenanceForm" model="Model" />
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
